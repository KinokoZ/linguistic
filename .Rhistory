ord.re <- order(fm1$ranef)
ci <- ci[order(fm1$ranef),]
plot(1:length(fm1$ranef), fm1$ranef[ord.re], axes=FALSE, ylim=range(ci),
xlab="Speaker", ylab="Speaker effect",main="ceb_click_flexible")
axis(1, at=1:length(fm1$ranef), labels = ord.re)
axis(2)
for(i in 1:length(fm1$ranef)) {
segments(i, ci[i, 1], i, ci[i, 2])
}
abline(h = 0, lty=2)
fm1 <- clmm2(rating ~ vk, random=speaker, data=ceb_click,threshold="symmetric")
pr1 <- profile(fm1, range=c(.1, 10), nSteps=30, trace=0)
plot(pr1, main="ceb_click_symmetric")
ci <- fm1$ranef + qnorm(0.975) * sqrt(fm1$condVar) %o% c(-1, 1)
ord.re <- order(fm1$ranef)
ci <- ci[order(fm1$ranef),]
plot(1:length(fm1$ranef), fm1$ranef[ord.re], axes=FALSE, ylim=range(ci),
xlab="Speaker", ylab="Speaker effect",main="ceb_click_symmetric")
axis(1, at=1:length(fm1$ranef), labels = ord.re)
axis(2)
for(i in 1:length(fm1$ranef)) {
segments(i, ci[i, 1], i, ci[i, 2])
}
abline(h = 0, lty=2)
fm1 <- clmm2(rating ~ vk, random=speaker, data=ceb_click,threshold = "equidistant")
pr1 <- profile(fm1, range=c(.1, 10), nSteps=30, trace=0)
plot(pr1, main="ceb_click_equidistant")
ci <- fm1$ranef + qnorm(0.975) * sqrt(fm1$condVar) %o% c(-1, 1)
ord.re <- order(fm1$ranef)
ci <- ci[order(fm1$ranef),]
plot(1:length(fm1$ranef), fm1$ranef[ord.re], axes=FALSE, ylim=range(ci),
xlab="Speaker", ylab="Speaker effect",main="ceb_click_equidistant")
axis(1, at=1:length(fm1$ranef), labels = ord.re)
axis(2)
for(i in 1:length(fm1$ranef)) {
segments(i, ci[i, 1], i, ci[i, 2])
}
abline(h = 0, lty=2)
