# 计算置信区间
ci <- fm2$ranef + qnorm(0.975) * sqrt(fm2$condVar) %o% c(-1, 1)
library(ordinal)
fm2 <- clmm2(rating ~ vk, random=speaker, data=ceb_click)
pr2 <- profile(fm2, range=c(.1, 10), nSteps=30, trace=0)
plot(pr2)
# 计算置信区间
ci <- fm2$ranef + qnorm(0.975) * sqrt(fm2$condVar) %o% c(-1, 1)
# 对随机效应进行排序
ord.re <- order(fm2$ranef)
# 根据排序后的随机效应调整置信区间
ci <- ci[order(fm2$ranef),]
# 绘制图形
plot(1:length(fm2$ranef), fm2$ranef[ord.re], axes=FALSE, ylim=range(ci),
xlab="Speaker", ylab="Speaker effect")
# 添加轴
axis(1, at=1:length(fm2$ranef), labels = ord.re)
axis(2)
# 添加置信区间线
for(i in 1:length(fm2$ranef)) {
segments(i, ci[i, 1], i, ci[i, 2])
}
# 添加水平参考线
abline(h = 0, lty=2)
